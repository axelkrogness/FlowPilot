{
  "name": "flowpilot",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx worker/index.ts",
    "typecheck": "tsc --noEmit",
    "cpp:build": "cmake -S cpp-worker -B cpp-worker/build && cmake --build cpp-worker/build",
    "verify:cpp": "cmake -S cpp-worker -B cpp-worker/build && cmake --build cpp-worker/build && ./cpp-worker/build/flowpilot-worker --health",
    "verify:source": "node scripts/verify-source.mjs",
    "verify": "npm run verify:source && npm run verify:cpp && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@xyflow/react": "^12.8.6",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "lucide-react": "^0.544.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
